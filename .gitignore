# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
*.env.local

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data (tracked via DVC/external storage, not git)
data/raw/*
data/processed/*
data/interim/*
data/external/*
!data/**/.gitkeep

# ChromaDB (derived -- rebuild with `python -m src.knowledge.ingest`)
data/chroma_db/

# Models / checkpoints
models/checkpoints/*
models/pretrained/*
!models/**/.gitkeep
*.pt
*.pth
*.onnx
*.ckpt

# Outputs
outputs/logs/*
outputs/predictions/*
outputs/figures/*
outputs/reports/*
!outputs/**/.gitkeep

# PyTorch Lightning / experiment tracking
lightning_logs/
mlruns/
wandb/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Distribution / build
build/
dist/
*.egg-info/
